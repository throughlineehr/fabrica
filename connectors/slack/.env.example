# Slack connector credentials.
#
# 1. Copy this file to .env in the same directory:
#       cp connectors/slack/.env.example connectors/slack/.env
# 2. Fill in your tokens in .env (NOT in this file). See README.md.
# 3. Run: npm run connector:slack
#
# .env is gitignored. .env.example is committed. Never put real tokens here.

SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional overrides:
# RELAY_URL=ws://localhost:8888/slack/all
# SLACK_INCLUDE_SUBTYPES=1
